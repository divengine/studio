<?php

/**
 * @file
 * Hooks for Divengine Traceability.
 */

declare(strict_types=1);

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Database\Query\SelectInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\divengine_traceability\Entity\TraceLinkInterface;

/**
 * Implements hook_ENTITY_TYPE_access().
 *
 * A forbidden endpoint must prevail even over another module's access grant.
 */
function divengine_traceability_trace_link_access(TraceLinkInterface $link, string $operation, AccountInterface $account): AccessResultInterface {
  $access = \Drupal::service('divengine_traceability.visibility')->endsAccess($link, $account);
  return $access->isAllowed() ? AccessResult::neutral()->addCacheableDependency($access) : $access;
}

/**
 * Implements hook_query_TAG_alter().
 */
function divengine_traceability_query_trace_link_access_alter(AlterableInterface $query): void {
  if ($query instanceof SelectInterface) {
    \Drupal::service('divengine_traceability.visibility')->alterQuery($query);
  }
}

/**
 * Implements hook_entity_delete().
 *
 * A trace link without one of its ends records nothing, so it goes with the
 * deleted entity.
 */
function divengine_traceability_entity_delete(EntityInterface $entity): void {
  divengine_traceability_invalidate_trace_access($entity);
  if (!$entity instanceof ContentEntityInterface || $entity->getEntityTypeId() === 'trace_link') {
    return;
  }
  \Drupal::service('divengine_traceability.reference_index')->forget($entity);
  $storage = \Drupal::entityTypeManager()->getStorage('trace_link');
  $query = $storage->getQuery()->accessCheck(FALSE);
  $source = $query->andConditionGroup()
    ->condition('source_entity_type', $entity->getEntityTypeId())
    ->condition('source_entity_id', $entity->id());
  $target = $query->andConditionGroup()
    ->condition('target_entity_type', $entity->getEntityTypeId())
    ->condition('target_entity_id', $entity->id());
  $ids = $query->condition($query->orConditionGroup()->condition($source)->condition($target))->execute();
  if ($ids) {
    $storage->delete($storage->loadMultiple($ids));
  }
}

/**
 * Implements hook_views_data_alter().
 *
 * Views treats list base fields as plain strings; filter the link type and
 * the confidence with a select of their allowed values instead.
 */
function divengine_traceability_views_data_alter(array &$data): void {
  foreach (['link_type', 'confidence'] as $field) {
    if (isset($data['trace_link'][$field]['filter'])) {
      $data['trace_link'][$field]['filter']['id'] = 'list_field';
      $data['trace_link'][$field]['filter']['field_name'] = $field;
      $data['trace_link'][$field]['filter']['entity_type'] = 'trace_link';
    }
  }
}

/**
 * Implements hook_entity_extra_field_info().
 */
function divengine_traceability_entity_extra_field_info(): array {
  $extra = [];
  $bundle_info = \Drupal::service('entity_type.bundle.info');
  foreach (\Drupal::service('divengine_traceability.trace_panel')->endTypes() as $entity_type_id) {
    foreach (array_keys($bundle_info->getBundleInfo($entity_type_id)) as $bundle) {
      $extra[$entity_type_id][$bundle]['display']['divengine_traces'] = [
        'label' => t('Traces'),
        'description' => t('Trace links from and to this record.'),
        'weight' => 60,
        'visible' => TRUE,
      ];
    }
  }
  return $extra;
}

/**
 * Implements hook_entity_view().
 */
function divengine_traceability_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($entity instanceof ContentEntityInterface && !$entity->isNew() && $display->getComponent('divengine_traces')) {
    $build['divengine_traces'] = \Drupal::service('divengine_traceability.trace_panel')->build($entity);
  }
  // Where a record with a code is mentioned ([[CODE]] in other texts).
  if ($entity instanceof ContentEntityInterface && !$entity->isNew() && in_array($view_mode, ['full', 'default'], TRUE)
    && \Drupal::service('divengine_traceability.code_resolver')->codeOf($entity) !== NULL) {
    $mentions = \Drupal::service('divengine_traceability.trace_panel')->mentions($entity);
    if ($mentions) {
      $build['divengine_mentions'] = $mentions + ['#weight' => 61];
    }
  }
}

/**
 * Implements hook_entity_insert().
 *
 * Records the [[CODE]] mentions of the new record's texts.
 */
function divengine_traceability_entity_insert(EntityInterface $entity): void {
  divengine_traceability_invalidate_trace_access($entity);
  if ($entity instanceof ContentEntityInterface && $entity->getEntityTypeId() !== 'trace_link') {
    \Drupal::service('divengine_traceability.reference_index')->index($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function divengine_traceability_entity_update(EntityInterface $entity): void {
  divengine_traceability_invalidate_trace_access($entity);
  if ($entity instanceof ContentEntityInterface && $entity->getEntityTypeId() !== 'trace_link') {
    \Drupal::service('divengine_traceability.reference_index')->index($entity);
  }
}

/**
 * Invalidates collections when endpoints or their access dependencies change.
 *
 * SQL access also affects empty lists/counts, which have no returned entities
 * from which JSON:API or Views could collect endpoint cache tags. Membership may
 * live on a parent/context rather than the endpoint itself.
 */
function divengine_traceability_invalidate_trace_access(EntityInterface $entity): void {
  if ($entity instanceof ContentEntityInterface) {
    \Drupal\Core\Cache\Cache::invalidateTags(['trace_link_list']);
    \Drupal::entityTypeManager()->getAccessControlHandler('trace_link')->resetCache();
  }
}
