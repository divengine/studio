<?php

/**
 * @file
 * Install and update functions for Divengine Traceability.
 */

declare(strict_types=1);

use Drupal\Core\Config\FileStorage;

/**
 * Implements hook_schema().
 */
function divengine_traceability_schema(): array {
  return [
    'divengine_reference' => [
      'description' => 'Records that mention other records with [[CODE]] in their texts.',
      'fields' => [
        'source_type' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE, 'description' => 'Entity type of the mentioning record.'],
        'source_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'ID of the mentioning record.'],
        'target_type' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE, 'description' => 'Entity type of the mentioned record.'],
        'target_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'ID of the mentioned record.'],
      ],
      'primary key' => ['source_type', 'source_id', 'target_type', 'target_id'],
      'indexes' => ['target' => ['target_type', 'target_id']],
    ],
  ];
}

/**
 * Create the table of mentions ([[CODE]] in texts).
 */
function divengine_traceability_update_11002(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('divengine_reference')) {
    $schema->createTable('divengine_reference', divengine_traceability_schema()['divengine_reference']);
  }
}

/**
 * Turn trace link types into configuration and use core revision fields.
 */
function divengine_traceability_update_11001(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $manager = \Drupal::entityDefinitionUpdateManager();

  if (!$manager->getEntityType('trace_link_type')) {
    $manager->installEntityType($entity_type_manager->getDefinition('trace_link_type'));
  }

  // Create the default types; existing ones are left as they are.
  $path = \Drupal::service('extension.list.module')->getPath('divengine_traceability');
  $source = new FileStorage($path . '/config/install');
  $storage = $entity_type_manager->getStorage('trace_link_type');
  foreach ($source->listAll('divengine_traceability.trace_link_type.') as $name) {
    $data = $source->read($name);
    if (!$storage->load($data['id'])) {
      $storage->createFromStorageRecord($data)->save();
    }
  }

  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('trace_link');
  foreach (['link_type', 'revision_uid', 'revision_timestamp', 'revision_log'] as $name) {
    $manager->updateFieldStorageDefinition($definitions[$name]);
  }
  $manager->updateEntityType($entity_type_manager->getDefinition('trace_link'));
  return (string) t('Trace link types are now configuration; trace links use core revision log fields.');
}
