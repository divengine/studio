<section{{ attributes.addClass('dv-section') }}>
  {% if title %}
    <header class="dv-section__header">
      <h2 class="dv-section__title">{{ title }}{% if count is not empty %} <span class="dv-section__count">{{ count }}</span>{% endif %}</h2>
      <div class="dv-section__actions">{% block actions %}{% endblock %}</div>
    </header>
  {% endif %}
  <div class="dv-section__content">{% block content %}{% endblock %}</div>
</section>
