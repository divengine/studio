<?php

/**
 * @file
 * Install, update and uninstall functions for Divengine Process.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function divengine_process_schema(): array {
  $schema['divengine_process_baseline_item'] = [
    'description' => 'The exact revisions that took part in a baseline.',
    'fields' => [
      'baseline_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'The baseline.'],
      'entity_type' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE, 'description' => 'Entity type of the record.'],
      'entity_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'ID of the record.'],
      'revision_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'description' => 'The exact revision of the record in the baseline.'],
    ],
    'primary key' => ['baseline_id', 'entity_type', 'entity_id'],
    'indexes' => [
      'revision' => ['entity_type', 'revision_id'],
      'record' => ['entity_type', 'entity_id'],
    ],
  ];
  return $schema;
}

/**
 * Creates the baseline item table.
 */
function divengine_process_update_10001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('divengine_process_baseline_item')) {
    $schema->createTable('divengine_process_baseline_item', divengine_process_schema()['divengine_process_baseline_item']);
  }
}

/**
 * Adds the captured item count to baselines.
 *
 * Existing baselines keep an empty count: it was not recorded when they were
 * taken, and it is not inferred from their items.
 */
function divengine_process_update_11001(): void {
  $definition = \Drupal\Core\Field\BaseFieldDefinition::create('integer')
    ->setLabel(new \Drupal\Core\StringTranslation\TranslatableMarkup('Captured items'))
    ->setDescription(new \Drupal\Core\StringTranslation\TranslatableMarkup('Written with the items in the same transaction: zero is a valid empty baseline. Empty for baselines taken before it was recorded.'))
    ->setSetting('unsigned', TRUE)
    ->setReadOnly(TRUE);
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('item_count', 'baseline', 'divengine_process', $definition);
}
