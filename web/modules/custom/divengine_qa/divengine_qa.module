<?php

/**
 * @file
 * Test management: hooks that tie the QA records to the Unified Process.
 */

declare(strict_types=1);

use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Database\Query\SelectInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\divengine_qa\QaLogger;
use Drupal\divengine_qa\QaPermissions;
use Drupal\divengine_qa\QaVerification;
use Drupal\divengine_qa\QaVocabulary;

/**
 * QA entity types that belong to a Development.
 */
const DIVENGINE_QA_SCOPED_TYPES = [
  'qa_test_plan',
  'qa_test_suite',
  'qa_test_case',
  'qa_test_step',
  'qa_test_run',
  'qa_test_execution',
  'qa_step_result',
  'qa_result_correction',
  'qa_issue',
];

/**
 * QA entity types that belong to a run, seen by Leads and the run's Tester.
 */
const DIVENGINE_QA_RUNTIME_TYPES = [
  'qa_test_run' => 'id',
  'qa_test_execution' => 'run',
  'qa_step_result' => 'run',
  'qa_result_correction' => 'run',
];

/**
 * Implements hook_divengine_process_scoped_types_alter().
 */
function divengine_qa_divengine_process_scoped_types_alter(array &$types): void {
  array_push($types, ...DIVENGINE_QA_SCOPED_TYPES);
}

/**
 * Implements hook_divengine_trace_end_types_alter().
 *
 * Test plans, suites, cases and runs verify requirements, use cases,
 * change requests and work products; a QA Issue can be traced to what it
 * affects.
 */
function divengine_qa_divengine_trace_end_types_alter(array &$types): void {
  array_push($types, 'qa_test_plan', 'qa_test_suite', 'qa_test_case', 'qa_test_run', 'qa_issue');
}

/**
 * Implements hook_query_alter().
 *
 * Lists of runs and of their executions, step results and corrections show
 * a user who is not a QA Lead only the runs assigned to them.
 */
function divengine_qa_query_alter(AlterableInterface $query): void {
  if (!$query instanceof SelectInterface) {
    return;
  }
  foreach (DIVENGINE_QA_RUNTIME_TYPES as $entity_type_id => $run_field) {
    if (!$query->hasTag($entity_type_id . '_access')) {
      continue;
    }
    $account = $query->getMetaData('account') ?: \Drupal::currentUser();
    if (QaPermissions::isLead($account)) {
      return;
    }
    $alias = NULL;
    foreach ($query->getTables() as $table_alias => $info) {
      if (($info['table'] ?? NULL) === $entity_type_id) {
        $alias = $table_alias;
        break;
      }
    }
    if ($alias === NULL) {
      return;
    }
    if (!QaPermissions::isUser($account) || $account->isAnonymous()) {
      $query->alwaysFalse();
      return;
    }
    $assigned = \Drupal::database()->select('qa_test_run', 'assigned')
      ->fields('assigned', ['id'])
      ->condition('assigned.tester', $account->id());
    $query->condition("$alias.$run_field", $assigned, 'IN');
  }
}


/**
 * Implements hook_entity_insert().
 */
function divengine_qa_entity_insert(EntityInterface $entity): void {
  if (isset(QaLogger::TRACKED[$entity->getEntityTypeId()])) {
    \Drupal::service('divengine_qa.logger')->track($entity);
  }
}

/**
 * Implements hook_entity_update().
 *
 * The activity of a QA record shows who changed its tracked fields.
 */
function divengine_qa_entity_update(EntityInterface $entity): void {
  if (isset(QaLogger::TRACKED[$entity->getEntityTypeId()])) {
    \Drupal::service('divengine_qa.logger')->track($entity);
  }
}

/**
 * Implements hook_entity_type_alter().
 */
function divengine_qa_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['trace_link'])) {
    $entity_types['trace_link']->addConstraint('QaVerificationTrace');
  }
}

/**
 * Implements hook_entity_view().
 *
 * Requirements, use cases, change requests and work products show their
 * verification, derived from the results of the tests that verify them.
 */
function divengine_qa_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($view_mode !== 'full' || !QaVerification::isVerifiable($entity) || !QaPermissions::isUser(\Drupal::currentUser())) {
    return;
  }
  $verification = \Drupal::service('divengine_qa.verification')->verification($entity);
  $tone = match ($verification['status']) {
    'passed' => 'success',
    'failed' => 'danger',
    'partial' => 'warning',
    default => 'neutral',
  };
  $rows = [];
  foreach ($verification['tests'] as $test) {
    $results = \Drupal::service('divengine_qa.verification')->results($test);
    $status = QaVerification::status($results);
    $rows[] = [
      ['data' => $test->toLink()->toRenderable()],
      ['data' => ['#plain_text' => (string) $test->getEntityType()->getSingularLabel()]],
      ['data' => ['#plain_text' => implode(', ', array_map(fn ($pair) => $pair[0]->label() . ': ' . (QaVocabulary::lastResults()[$pair[1]] ?? $pair[1]), $results))]],
      ['data' => ['#type' => 'component', '#component' => 'divengine_core:badge', '#props' => ['label' => (string) QaVerification::statuses()[$status], 'tone' => $status === 'passed' ? 'success' : ($status === 'failed' ? 'danger' : 'neutral')]]],
    ];
  }
  $build['dv_qa_verification'] = [
    '#type' => 'component',
    '#component' => 'divengine_core:section',
    '#props' => ['title' => (string) t('Verification'), 'count' => (string) count($rows), 'description' => (string) t('Derived from the results of the tests that verify this record.')],
    '#slots' => [
      'actions' => ['#type' => 'component', '#component' => 'divengine_core:badge', '#props' => ['label' => (string) QaVerification::statuses()[$verification['status']], 'tone' => $tone]],
      'content' => [
        '#type' => 'table',
        '#header' => [t('Verified by'), t('Kind'), t('Results'), t('Status')],
        '#rows' => $rows,
        '#empty' => t('No test verifies this record. Add a "Verifies" trace from a test plan, suite, case or run.'),
      ],
    ],
    '#weight' => 90,
    '#cache' => [
      'tags' => ['trace_link_list', 'qa_test_case_list', 'qa_test_run_list', 'qa_test_execution_list'],
      'contexts' => ['user'],
    ],
  ];
}
