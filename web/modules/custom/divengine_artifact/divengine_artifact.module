<?php

/**
 * @file
 * Hooks for Divengine Artifact.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_views_data_alter().
 *
 * Artifacts are not translatable, so their fields live in the base table and
 * the declared data table is never created. Content moderation registers its
 * Views integration on the data table; move it to the table that exists.
 */
function divengine_artifact_views_data_alter(array &$data): void {
  foreach (['artifact_field_data' => 'artifact', 'artifact_field_revision' => 'artifact_revision'] as $declared => $actual) {
    if (isset($data[$declared]['moderation_state'], $data[$actual]) && !isset($data[$declared]['table'])) {
      $data[$actual]['moderation_state'] = $data[$declared]['moderation_state'];
      unset($data[$declared]['moderation_state']);
      if ($data[$declared] === []) {
        unset($data[$declared]);
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view() for artifact.
 *
 * The full page opens with a status bar: key, state, type and owner.
 */
function divengine_artifact_artifact_view(array &$build, EntityInterface $artifact, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($view_mode !== 'full') {
    return;
  }
  /** @var \Drupal\divengine_artifact\Entity\ArtifactInterface $artifact */
  $state = $artifact->get('moderation_state')->value ?? NULL;
  $workflow = \Drupal::service('content_moderation.moderation_information')->getWorkflowForEntity($artifact);
  if ($state && $workflow) {
    $state_definition = $workflow->getTypePlugin()->getState($state);
    $label = $state_definition->label();
    $tone = match (TRUE) {
      $state === 'deprecated' => 'danger',
      $state_definition->isPublishedState() => 'success',
      $state === 'draft' => 'neutral',
      default => 'info',
    };
  }
  else {
    $label = $artifact->isPublished() ? t('Active') : t('Archived');
    $tone = $artifact->isPublished() ? 'neutral' : 'warning';
  }
  $facts = [
    ['label' => (string) t('Type'), 'value' => (string) $artifact->get('type')->entity?->label()],
    ['label' => (string) t('Owner'), 'value' => (string) $artifact->getOwner()?->getDisplayName()],
    ['label' => (string) t('Changed'), 'value' => \Drupal::service('date.formatter')->format($artifact->getChangedTime(), 'short')],
  ];
  $build['dv_status'] = [
    '#type' => 'component',
    '#component' => 'divengine_core:status-bar',
    '#props' => ['code' => $artifact->getArtifactKey(), 'facts' => $facts],
    '#slots' => [
      'badge' => [
        '#type' => 'component',
        '#component' => 'divengine_core:badge',
        '#props' => ['label' => (string) $label, 'tone' => $tone],
      ],
    ],
    '#weight' => -100,
  ];
}
