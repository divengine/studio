{#
/**
 * @file
 * The comment thread of a record, styled as a Studio section.
 */
#}
<section{{ attributes.addClass('dv-section', 'dv-comments') }}>
  <header class="dv-section__header">
    <div class="dv-section__heading">
      <h2 class="dv-section__title">{{ label }}{% if element['#object'].get(field_name).comment_count %} <span class="dv-section__count">{{ element['#object'].get(field_name).comment_count }}</span>{% endif %}</h2>
    </div>
  </header>
  <div class="dv-section__content">
    {% if comments %}
      <div class="dv-comments__list">{{ comments }}</div>
    {% else %}
      <p class="dv-comments__empty">{{ 'No comments yet. Start the conversation below.'|t }}</p>
    {% endif %}
    {% if comment_form %}
      <div class="dv-comments__form">{{ comment_form }}</div>
    {% endif %}
  </div>
</section>
